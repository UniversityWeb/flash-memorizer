# Copy this file to .env and fill in secret values before use.

# Database Configuration
POSTGRES_USER=flashuser
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=FlashMemorizer

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=CHANGEME_PGADMIN_PASSWORD

# Application Configuration
PROD_DB_URL=flash-memorizer-db:5432/FlashMemorizer
PROD_DB_USER=flashuser
PROD_DB_PASSWORD=CHANGEME_PROD_DB_PASSWORD
PROD_MAIL_EMAIL=your_email@example.com
PROD_MAIL_PASSWORD=CHANGEME_MAIL_PASSWORD
